{
  "openapi": "3.1.0",
  "info": {
    "title": "SupportPilot Actions — status-helper",
    "description": "Business operations the SupportPilot agent may request on behalf of an authenticated support user. Every operation authorizes the individual user; none accepts an identity supplied by the caller.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://broker:8097/status-helper",
      "description": "The delegation broker, as the status-helper profile. Every call is made with a token naming the user and status-helper, narrowed to the call."
    }
  ],
  "paths": {
    "/v1/orders/{order_number}": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get an order visible to the authenticated user",
        "operationId": "get_order",
        "parameters": [
          {
            "name": "order_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 16,
              "pattern": "^ORD-[0-9]{4,12}$",
              "description": "Order number in the form ORD-nnnn",
              "examples": [
                "ORD-2001"
              ],
              "title": "Order Number"
            },
            "description": "Order number in the form ORD-nnnn"
          },
          {
            "name": "include_items",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include the order's line items",
              "default": false,
              "title": "Include Items"
            },
            "description": "Include the order's line items"
          },
          {
            "name": "include_shipment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include shipment and tracking status",
              "default": false,
              "title": "Include Shipment"
            },
            "description": "Include shipment and tracking status"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "Not found or not allowed"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderItem": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_amount": {
            "type": "string",
            "title": "Unit Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "description",
          "quantity",
          "unit_amount"
        ],
        "title": "OrderItem"
      },
      "OrderResponse": {
        "properties": {
          "order_number": {
            "type": "string",
            "title": "Order Number",
            "description": "The order identifier, e.g. ORD-2001"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Order lifecycle status"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency"
          },
          "total_amount": {
            "type": "string",
            "title": "Total Amount",
            "description": "Decimal amount as a string, to avoid float rounding"
          },
          "placed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Placed At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "items": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/OrderItem"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Items"
          },
          "shipment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Shipment"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_number",
          "status",
          "currency",
          "total_amount",
          "placed_at",
          "updated_at"
        ],
        "title": "OrderResponse",
        "description": "The bounded response schema.\n\n`extra=\"forbid\"` means a field the repository adds later cannot reach the caller until someone\nadds it here deliberately — response minimization by construction rather than by review."
      },
      "Shipment": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "carrier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carrier"
          },
          "tracking_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tracking Ref"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "updated_at"
        ],
        "title": "Shipment"
      }
    }
  }
}
