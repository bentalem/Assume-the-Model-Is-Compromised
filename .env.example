# SupportPilot local configuration.
# Names and safe defaults ONLY. Real secret values live in ./.secrets/ and are never committed.
# Copy to .env and adjust if needed: cp .env.example .env

# --- Identity (SP-DATA-001 §2) ------------------------------------------------------------------
KEYCLOAK_ISSUER=https://keycloak:8443/realms/supportpilot
KEYCLOAK_JWKS_URL=https://keycloak:8443/realms/supportpilot/protocol/openid-connect/certs
SUPPORTPILOT_AUDIENCE=supportpilot-api
TOKEN_LEEWAY_SECONDS=30
KEYCLOAK_ADMIN_USER=kcadmin

# Issuer as reachable from the host, for the test harness (scripts/get-token.ps1).
KEYCLOAK_PUBLIC_ISSUER=https://localhost:8443/realms/supportpilot

# --- Policy (SP-DATA-001 §4) --------------------------------------------------------------------
OPA_URL=http://opa:8181/v1/data/supportpilot/authz/decision
OPA_TIMEOUT_MS=250

# --- Database (no credentials here; see ./.secrets/) ---------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=supportpilot
POSTGRES_BOOTSTRAP_USER=supportpilot_admin
API_DATABASE_SECRET_FILE=/run/secrets/api_db_password
WORKER_DATABASE_SECRET_FILE=/run/secrets/worker_db_password

# --- Business limits (versioned policy data holds the per-role limits) ---------------------------
ACTION_MAX_AMOUNT=500.00
AGENT_MAX_TOOL_CALLS=8
AUDIT_RETENTION_DAYS=365

# --- Worker -------------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=300

# --- Local environment behavior ------------------------------------------------------------------
SEED_LOCAL_DATA=true
LOG_LEVEL=INFO

# --- Onyx (opt-in profile, ADR-0002) -------------------------------------------------------------
ONYX_AUTH_TYPE=oidc
ONYX_OAUTH_CLIENT_ID=onyx-web
