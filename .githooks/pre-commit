#!/bin/sh
# SupportPilot pre-commit hook.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -e

python scripts/scan_secrets.py || exit 1

# The registered action set must match the running code. Skipped when the API is not up, because a
# hook that fails whenever Docker is stopped only teaches people to use --no-verify.
if docker compose ps --status running --services 2>/dev/null | grep -qx api; then
  python scripts/export_openapi.py --check || {
    echo "The action document is out of date. Run: python scripts/export_openapi.py"
    exit 1
  }
fi
